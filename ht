# ============================================================

def format_workbook(path):

    wb = load_workbook(
        path
    )

    for ws in wb.worksheets:

        ws.freeze_panes = "A2"

        if ws.max_row >= 1:

            ws.auto_filter.ref = (
                ws.dimensions
            )

        for column_cells in ws.columns:

            max_length = 0

            column_letter = (
                column_cells[0]
                .column_letter
            )

            for cell in column_cells:

                value = cell.value

                if value is not None:

                    max_length = max(
                        max_length,
                        len(str(value)),
                    )

            ws.column_dimensions[
                column_letter
            ].width = min(
                max_length + 2,
                45,
            )

    wb.save(path)


# ============================================================
# DAILY JOB
# ============================================================

def run_daily_job():

    # ========================================================
    # AUTOMATIC RUN DATE
    # ========================================================

    run_date = (
        pd.Timestamp.today()
        .normalize()
    )

    month = month_from_date(
        run_date
    )

    print()
    print("=" * 80)
    print("AUDITOR DAILY CALL SELECTION")
    print("=" * 80)

    print(
        f"Run date: {run_date.date()}"
    )

    print(
        f"Month: {month}"
    )

    # ========================================================
    # SUNDAY
    # ========================================================

    if not is_call_day(
        run_date
    ):

        print(
            "Today is Sunday."
        )

        print(
            "No call selection will be performed."
        )

        return

    # ========================================================
    # LOAD INPUT FILES
    # ========================================================

    print()
    print("Loading input files...")

    mapping = load_mapping()

    configs = load_configs()

    calls = load_calls()

    print(
        f"Assignments loaded: {len(mapping)}"
    )

    print(
        f"Configurations loaded: {len(configs)}"
    )

    print(
        f"Calls loaded: {len(calls)}"
    )

    # ========================================================
    # TODAY'S CALLS
    # ========================================================

    today_calls = calls[
        calls["run_date"]
        == run_date
    ].copy()

    print(
        f"Today's calls: "
        f"{len(today_calls)}"
    )

    # ========================================================
    # MONTHLY WORKBOOK
    # ========================================================

    workbook = workbook_path(
        month
    )

    create_workbook_if_needed(
        workbook,
        run_date,
    )

    # ========================================================
    # LOAD MONTH-TO-DATE HISTORY
    # ========================================================

    selections = load_selections(
        workbook
    )

    # ========================================================
    # RERUN
    #
    # Remove today's previous selections only.
    # ========================================================

    before_count = len(
        selections
    )

    selections = remove_run_date(
        selections,
        run_date,
    )

    removed_count = (
        before_count
        - len(selections)
    )

    if removed_count > 0:

        print()
        print(
            f"Rerun detected: removed "
            f"{removed_count} existing "
            f"selections from today's run."
        )

    # ========================================================
    # MONTHLY ANCHOR
    # ========================================================

    anchor = load_run_anchor(
        workbook
    )

    # Safety check.
    if (
        anchor.year != run_date.year
        or anchor.month != run_date.month
    ):
        raise ValueError(
            "The Run_Anchor belongs to a "
            "different month than today's "
            "workbook."
        )

    print(
        f"Sampling anchor: "
        f"{anchor.date()}"
    )

    # ========================================================
    # DAILY OUTPUT
    # ========================================================

    daily_rows = []

    # ========================================================
    # PROCESS EACH ASSIGNMENT
    # ========================================================

    for assignment in mapping.itertuples(
        index=False
    ):

        auditor_id = str(
            assignment.auditor_id
        )

        agent_id = str(
            assignment.agent_id
        )

        # ----------------------------------------------------
        # Each agent gets processed independently.
        # ----------------------------------------------------

        for category in sorted(
            CATEGORIES
        ):

            key = (
                auditor_id,
                month,
                category,
            )

            if key not in configs:

                raise ValueError(
                    "Missing configuration for "
                    f"auditor={auditor_id}, "
                    f"month={month}, "
                    f"category={category}"
                )

            config = configs[
                key
            ]

            pair = PairKey(
                auditor_id=auditor_id,
                agent_id=agent_id,
                category=category,
            )

            # =================================================
            # MONTHLY QUOTA
            # =================================================

            remaining = remaining_quota(
                selections,
                pair,
                config,
            )

            if remaining <= 0:
                continue

            # =================================================
            # PACING
            # =================================================

            due_today = (
                selections_due_today(
                    selections,
                    pair,
                    config,
                    run_date,
                )
            )

            at_risk = quota_at_risk(
                selections,
                pair,
                config,
                run_date,
            )

            # =================================================
            # NOT DUE YET
            # =================================================

            if (
                due_today <= 0
                and not at_risk
            ):
                continue

            # =================================================
            # NUMBER OF CALLS TO TRY TODAY
            # =================================================

            number_to_select = max(
                1,
                due_today,
            )

            number_to_select = min(
                number_to_select,
                remaining,
            )

            selected_today = 0

            # =================================================
            # SELECT TODAY'S CALLS
            # =================================================

            while (
                selected_today
                < number_to_select
            ):

                # ------------------------------------------------
                # Candidate calls for this agent/category today.
                # ------------------------------------------------

                candidates = today_calls[
                    (
                        today_calls[
                            "agent_id"
                        ]
                        == agent_id
                    )
                    &
                    (
                        today_calls[
                            "category"
                        ]
                        == category
                    )
                ].copy()

                # ------------------------------------------------
                # NEVER SELECT A CALL ID TWICE.
                #
                # The monthly Excel history is the source of truth.
                # ------------------------------------------------

                if not selections.empty:

                    used_call_ids = set(
                        selections[
                            "call_id"
                        ]
                        .astype(str)
                    )

                    candidates = candidates[
                        ~candidates[
                            "call_id"
                        ]
                        .astype(str)
                        .isin(
                            used_call_ids
                        )
                    ]

                if candidates.empty:

                    break

                # =================================================
                # RECHECK PACING RISK
                # =================================================

                risk_now = quota_at_risk(
                    selections,
                    pair,
                    config,
                    run_date,
                )

                # =================================================
                # RELAXATION LADDER
                # =================================================

                result = (
                    apply_relaxation_ladder(
                        candidates=candidates,
                        pair=pair,
                        history=selections,
                        config=config,
                        anchor=anchor,
                        allow_relaxation=risk_now,
                    )
                )

                # =================================================
                # NOTHING FOUND
                # =================================================

                if result.call is None:

                    break

                # =================================================
                # IMMEDIATELY UPDATE HISTORY
                # =================================================

                selections = add_selection(
                    selections=selections,
                    pair=pair,
                    call=result.call,
                    result=result,
                    anchor=anchor,
                )

                selected_today += 1

                call = result.call

                # =================================================
                # DAILY OUTPUT ROW
                # =================================================

                daily_rows.append(
                    {
                        "run_date": (
                            run_date
                        ),

                        "auditor_id": (
                            auditor_id
                        ),

                        "agent_id": (
                            agent_id
                        ),

                        "category": (
                            category
                        ),

                        "call_id": str(
                            call[
                                "call_id"
                            ]
                        ),

                        "call_date": (
                            pd.Timestamp(
                                call[
                                    "call_date"
                                ]
                            ).date()
                        ),

                        "call_length": float(
                            call[
                                "call_length"
                            ]
                        ),

                        "sampling_week": (
                            sampling_week(
                                call[
                                    "call_date"
                                ],
                                anchor,
                            )
                        ),

                        "relaxation_level": (
                            result
                            .relaxation_level
                        ),

                        "length_relaxed": (
                            result
                            .length_relaxed
                        ),

                        "required_calls": (
                            config
                            .required_calls
                        ),

                        "working_days": (
                            config
                            .working_days
                        ),

                        "min_call_length": (
                            config
                            .min_call_length
                        ),

                        "max_call_length": (
                            config
                            .max_call_length
                        ),

                        "weekly_rule_within_category": (
                            config
                            .weekly_rule_within_category
                        ),

                        "same_day_rule_across_category": (
                            config
                            .same_day_rule_across_category
                        ),

                        "same_day_within_category": (
                            config
                            .same_day_within_category
                        ),

                        "selection_reason": (
                            result.reason
                        ),
                    }
                )

    # ========================================================
    # SAVE MONTH-TO-DATE SELECTIONS
    # ========================================================

    write_selections(
        workbook,
        selections,
    )

    # ========================================================
    # DAILY OUTPUT
    # ========================================================

    daily_output = pd.DataFrame(
        daily_rows,
        columns=DAILY_OUTPUT_COLUMNS,
    )

    append_daily_output(
        workbook,
        daily_output,
        run_date,
    )

    # ========================================================
    # STATS
    # ========================================================

    stats = build_statistics(
        mapping=mapping,
        configs=configs,
        selections=selections,
        month=month,
        run_date=run_date,
    )

    write_statistics(
        workbook,
        stats,
    )

    # ========================================================
    # FORMAT EXCEL
    # ========================================================

    format_workbook(
        workbook
    )

    # ========================================================
    # SUMMARY
    # ========================================================

    print()
    print("=" * 80)
    print("RUN COMPLETE")
    print("=" * 80)

    print(
        f"Selected today: "
        f"{len(daily_output)}"
    )

    print(
        f"Month-to-date selections: "
        f"{len(selections)}"
    )

    if not stats.empty:

        completed = int(
            stats[
                "complete"
            ].sum()
        )

        total_auditors = len(
            stats
        )

        print(
            f"Auditors completed: "
            f"{completed}/"
            f"{total_auditors}"
        )

    print(
        f"Workbook: {workbook}"
    )

    print("=" * 80)


