def load_configs():

    df = pd.read_csv(
        WORKING_DAYS_FILE
    )

    required = {
        "auditor_id",
        "month",
        "category",
        "required_calls",
        "working_days",
        "min_call_length",
        "max_call_length",
        "weekly_rule_within_category",
        "same_day_rule_across_category",
        "same_day_within_category",
        "vacation_date",
        "vacation_start_date",
        "vacation_end_date",
    }

    missing = (
        required
        - set(df.columns)
    )

    if missing:
        raise ValueError(
            f"{WORKING_DAYS_FILE} is missing "
            f"columns: {sorted(missing)}"
        )

    df["auditor_id"] = (
        df["auditor_id"]
        .astype(str)
        .str.strip()
    )

    df["month"] = (
        df["month"]
        .astype(str)
        .str.strip()
    )

    df["category"] = (
        df["category"]
        .apply(normalize_category)
    )

    df["required_calls"] = pd.to_numeric(
        df["required_calls"],
        errors="raise",
    ).astype(int)

    df["working_days"] = pd.to_numeric(
        df["working_days"],
        errors="raise",
    ).astype(int)

    if (df["required_calls"] < 0).any():
        raise ValueError(
            "required_calls cannot be negative."
        )

    if (df["working_days"] < 0).any():
        raise ValueError(
            "working_days cannot be negative."
        )

    df["min_call_length"] = pd.to_numeric(
        df["min_call_length"],
        errors="coerce",
    )

    df["max_call_length"] = pd.to_numeric(
        df["max_call_length"],
        errors="coerce",
    )

    for column in [
        "weekly_rule_within_category",
        "same_day_rule_across_category",
        "same_day_within_category",
    ]:
        df[column] = (
            df[column]
            .apply(parse_bool)
        )

    configs = {}

    for row in df.itertuples(
        index=False
    ):

        key = (
            str(row.auditor_id),
            str(row.month),
            str(row.category),
        )

        if key in configs:
            raise ValueError(
                f"Duplicate auditor configuration: "
                f"{key}"
            )

        configs[key] = AuditorConfig(
            auditor_id=str(
                row.auditor_id
            ),

            month=str(
                row.month
            ),

            category=str(
                row.category
            ),

            required_calls=int(
                row.required_calls
            ),

            working_days=int(
                row.working_days
            ),

            min_call_length=(
                None
                if pd.isna(
                    row.min_call_length
                )
                else float(
                    row.min_call_length
                )
            ),

            max_call_length=(
                None
                if pd.isna(
                    row.max_call_length
                )
                else float(
                    row.max_call_length
                )
            ),

            weekly_rule_within_category=(
                bool(
                    row.weekly_rule_within_category
                )
            ),

            same_day_rule_across_category=(
                bool(
                    row.same_day_rule_across_category
                )
            ),

            same_day_within_category=(
                bool(
                    row.same_day_within_category
                )
            ),

            vacation_dates=build_vacation_dates(
                row.vacation_date,
                row.vacation_start_date,
                row.vacation_end_date,
            ),
        )

    return configs


