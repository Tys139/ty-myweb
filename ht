def append_daily_output(
    path,
    daily_output,
    run_date,
):
    """
    Keep all daily outputs in one sheet.

    If today's run is repeated, today's previous
    rows are removed first.
    """

    existing = pd.read_excel(
        path,
        sheet_name="Daily_Output",
    )

    if not existing.empty:

        existing["run_date"] = (
            pd.to_datetime(
                existing["run_date"]
            ).dt.normalize()
