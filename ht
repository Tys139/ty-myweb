        existing = existing[
            existing["run_date"]
            != run_date
        ]

    combined = pd.concat(
        [
            existing,
            daily_output,
        ],
        ignore_index=True,
    )

    combined.to_excel(
        path,
        sheet_name="Daily_Output",
        index=False,
    )


# ============================================================
# STATISTICS
# ============================================================

def build_statistics(
    mapping,
    configs,
    selections,
    month,
    run_date,
):
    """
    Build current monthly auditor statistics.

    This sheet is rebuilt every run.
    """

    rows = []

    auditors = sorted(
        mapping[
            "auditor_id"
        ]
        .astype(str)
        .unique()
    )

    for auditor_id in auditors:

        agents = sorted(
            mapping[
                mapping["auditor_id"]
                == auditor_id
            ][
                "agent_id"
            ]
            .astype(str)
            .unique()
        )

        total_required = 0
        total_selected = 0

        bind_required = 0
        bind_selected = 0

        policy_required = 0
        policy_selected = 0

        for agent_id in agents:

            for category in sorted(
                CATEGORIES
            ):

                key = (
                    auditor_id,
                    month,
                    category,
                )

                config = configs.get(
                    key
                )

                if config is None:
                    continue

                required = (
                    config.required_calls
                )

                total_required += required

                if category == "bind":
                    bind_required += required
                else:
                    policy_required += required

                if selections.empty:

                    count = 0

                else:

                    count = len(
                        selections[
                            (
                                selections[
                                    "auditor_id"
                                ]
                                == auditor_id
                            )
                            &
                            (
                                selections[
                                    "agent_id"
                                ]
                                == agent_id
                            )
                            &
                            (
                                selections[
                                    "category"
                                ]
                                == category
                            )
                        ]
                    )

                count = min(
                    count,
                    required,
                )

                total_selected += count

                if category == "bind":
                    bind_selected += count
                else:
                    policy_selected += count

        total_remaining = max(
            0,
            total_required
            - total_selected,
        )

        completion = (
            0
            if total_required == 0
            else (
                total_selected
                / total_required
                * 100
            )
        )

        auditor_configs = [
            config
            for key, config in configs.items()
            if (
                key[0] == auditor_id
                and key[1] == month
            )
        ]

        working_days = (
            auditor_configs[0]
            .working_days
            if auditor_configs
            else None
        )

        vacation_dates = set()

        for config in auditor_configs:
            vacation_dates.update(
                config.vacation_dates
            )

        rows.append(
            {
                "run_date": run_date.date(),

                "month": month,

                "auditor_id": auditor_id,

                "agents_assigned": len(
                    agents
                ),

                "working_days": (
                    working_days
                ),

                "vacation_pacing_days": len(
                    vacation_dates
                ),

                "bind_required": (
                    bind_required
                ),

                "bind_selected": (
                    bind_selected
                ),

                "bind_remaining": (
                    bind_required
                    - bind_selected
                ),

                "policy_change_required": (
                    policy_required
                ),

                "policy_change_selected": (
                    policy_selected
                ),

                "policy_change_remaining": (
                    policy_required
                    - policy_selected
                ),

                "total_required": (
                    total_required
                ),

                "total_selected": (
                    total_selected
                ),

                "total_remaining": (
                    total_remaining
                ),

                "completion_percent": round(
                    completion,
                    2,
                ),

                "complete": (
                    total_remaining == 0
                ),
            }
        )

    return pd.DataFrame(
        rows
    )


