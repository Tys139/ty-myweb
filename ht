# ============================================================
# CALL DAYS
# ============================================================

def is_call_day(date):

    """
    Calls are available Monday-Saturday.

    Monday = 0
    ...
    Saturday = 5
    Sunday = 6
    """

    return (
        pd.Timestamp(date).weekday()
        <= 5
    )


# ============================================================
# MONTH BOUNDARY
# ============================================================

def month_start(date):

    return pd.Timestamp(
        date
    ).normalize().replace(
        day=1
    )


def month_end(date):

    date = pd.Timestamp(
        date
    ).normalize()

    return (
        date
        + pd.offsets.MonthEnd(0)
    ).normalize()


# ============================================================
# SAMPLING WEEK
# ============================================================

def sampling_week(
    call_date,
    anchor,
):
    """
    Sampling weeks NEVER cross a calendar month.

    Example:

        Anchor = 2026-08-03

        Week 1 = Aug 03 - Aug 09
        Week 2 = Aug 10 - Aug 16
        Week 3 = Aug 17 - Aug 23
        Week 4 = Aug 24 - Aug 30
        Week 5 = Aug 31

    September starts a new workbook and therefore
    a new Week 1.

    This function deliberately raises an error if
    call_date and anchor belong to different months.
    """

    call_date = pd.Timestamp(
        call_date
    ).normalize()

    anchor = pd.Timestamp(
        anchor
    ).normalize()

    if (
        call_date.year != anchor.year
        or call_date.month != anchor.month
    ):
        raise ValueError(
            "Sampling week cannot cross "
            "a calendar-month boundary. "
            f"Call date: {call_date.date()}, "
            f"anchor: {anchor.date()}"
        )

    if call_date < anchor:
        raise ValueError(
            "Call date cannot be before "
            "the monthly run anchor."
        )

    days_from_anchor = (
        call_date - anchor
    ).days

    return (
        days_from_anchor // 7
    ) + 1


# ============================================================
# PACING - NORMAL DAYS
# ============================================================

def normal_pacing_days_elapsed(
    current_date,
):
    """
    Count Monday-Saturday days from the first
    calendar day of the month through current_date.
    """

    current_date = pd.Timestamp(
        current_date
    ).normalize()

    first = month_start(
        current_date
    )

    dates = pd.date_range(
        first,
        current_date,
        freq="D",
    )

    return sum(
        is_call_day(d)
        for d in dates
    )


# ============================================================
# PACING - VACATIONS
# ============================================================

def future_vacation_days(
    current_date,
    config,
):
    """
    Return future Monday-Saturday vacation dates
    in the same month.

    Vacation is NOT a blocked selection day.

    These dates only affect pacing.
    """

    current_date = pd.Timestamp(
        current_date
    ).normalize()

    return sorted(
        [
            d
            for d in config.vacation_dates
            if (
                d > current_date
                and d.year
                == current_date.year
                and d.month
                == current_date.month
                and is_call_day(d)
            )
        ]
    )


def pacing_days_elapsed(
    current_date,
    config,
):
    """
    Calculate how much pacing progress has occurred.

    With no vacation:
        normal Monday-Saturday progress.

    With vacation:
        vacation dates create additional pacing pressure,
        because the auditor has less practical time later.

    IMPORTANT:
        Vacation does not prevent today's selection.
    """

    normal_days = (
        normal_pacing_days_elapsed(
            current_date
        )
    )

    if not config.vacation_dates:

        return min(
            normal_days,
            config.working_days,
        )

    future_vacations = (
        future_vacation_days(
            current_date,
            config,
        )
    )

    vacation_pressure = len(
        future_vacations
    )

    return min(
        normal_days
        + vacation_pressure,
        config.working_days,
    )


def remaining_pacing_days(
    current_date,
    config,
):

    elapsed = pacing_days_elapsed(
        current_date,
        config,
    )

    return max(
        0,
        config.working_days
        - elapsed,
    )


# ============================================================
# PACING TARGET
# ============================================================

def pacing_target(
    quota,
    working_days,
    elapsed_days,
):
    """
    Determine how many calls should have been
    completed by this point.

    Example:

        quota = 3
        working_days = 21

    The target gradually moves toward 3 instead
    of asking for all 3 near the end of the month.
    """

    if quota <= 0:
        return 0

    if working_days <= 0:
        return 0

    elapsed_days = min(
        elapsed_days,
        working_days,
    )

    return min(
        quota,
        math.ceil(
            quota
            * elapsed_days
            / working_days
        ),
    )


# ============================================================
# PAIR HISTORY
# ============================================================

def pair_history(
    selections,
    pair,
):

    if selections.empty:
        return selections

    return selections[
        (
            selections["auditor_id"]
            == pair.auditor_id
        )
        &
        (
            selections["agent_id"]
            == pair.agent_id
        )
        &
        (
            selections["category"]
            == pair.category
        )
    ].copy()


def agent_history(
    selections,
    pair,
):

    if selections.empty:
        return selections

    return selections[
        (
            selections["auditor_id"]
            == pair.auditor_id
        )
        &
        (
            selections["agent_id"]
            == pair.agent_id
        )
    ].copy()


# ============================================================
# QUOTA
# ============================================================

def selected_count(
    selections,
    pair,
):

    return len(
        pair_history(
            selections,
            pair,
        )
    )


def remaining_quota(
    selections,
    pair,
    config,
):

    return max(
        0,
        config.required_calls
        - selected_count(
            selections,
            pair,
        ),
    )


# ============================================================
# PACING STATUS
# ============================================================

def selections_due_today(
    selections,
    pair,
    config,
    current_date,
):

    target = pacing_target(
        config.required_calls,
        config.working_days,
        pacing_days_elapsed(
            current_date,
            config,
        ),
    )

    already_selected = selected_count(
        selections,
        pair,
    )

    return max(
        0,
        target
        - already_selected,
    )


def quota_at_risk(
    selections,
    pair,
    config,
    current_date,
):
    """
    Quota is at risk when the remaining number
    of calls exceeds the remaining pacing days.

    Example:

        3 calls remain
        2 pacing days remain

    Therefore at least one day will need
    additional pressure / relaxation.
    """

    remaining = remaining_quota(
        selections,
        pair,
        config,
    )

    days_left = remaining_pacing_days(
        current_date,
        config,
    )

    return (
        remaining > days_left
    )


# ============================================================
# LENGTH VALIDATION
# ============================================================

def length_is_valid(
    length,
    minimum,
    maximum,
):

    if (
        minimum is not None
        and length < minimum
    ):
        return False

    if (
        maximum is not None
        and length > maximum
    ):
        return False

    return True


# ============================================================
# STRICT LENGTH SELECTION
# ============================================================

def select_shortest_qualifying_call(
    candidates,
    minimum,
    maximum,
):
    """
    Select the shortest call that satisfies
    the configured min/max length.

    This function is intentionally independent
    and can be unit tested separately.
    """

    if candidates.empty:
        return None

    eligible = candidates[
        candidates["call_length"].apply(
            lambda x:
            length_is_valid(
                x,
                minimum,
                maximum,
            )
        )
    ].copy()

    if eligible.empty:
        return None

    return (
        eligible
        .sort_values(
            [
                "call_length",
                "call_id",
            ]
        )
        .iloc[0]
    )


# ============================================================
# RELAXED LENGTH SELECTION
# ============================================================

def select_relaxed_length_call(
    candidates,
    minimum,
    maximum,
):
    """
    LEVEL 4.

    If no call fits the configured range,
    find the call requiring the smallest
    deviation outside that range.

    Ties are resolved by choosing the
    shortest call.
    """

    if candidates.empty:
        return None

    choices = []

    for _, row in candidates.iterrows():

        length = float(
            row["call_length"]
        )

        if length_is_valid(
            length,
            minimum,
            maximum,
        ):

            distance = 0.0

        elif (
            minimum is not None
            and length < minimum
        ):

            distance = (
                minimum
                - length
            )

        elif (
            maximum is not None
            and length > maximum
        ):

            distance = (
                length
                - maximum
            )

        else:

            distance = 0.0

        choices.append(
            (
                distance,
                length,
                str(row["call_id"]),
                row,
            )
        )

    choices.sort(
        key=lambda x: (
            x[0],
            x[1],
            x[2],
        )
    )

    return choices[0][3]


# ============================================================
# WEEKLY CONSTRAINT
# ============================================================

def apply_weekly_rule(
    candidates,
    history,
    pair,
    anchor,
):
    """
    Enforce:

        Same auditor
        Same agent
        Same category

    cannot have two selections
    in the same sampling week.

    The week is calculated from the
    monthly anchor and NEVER crosses
    the calendar month.
    """

    pair_hist = pair_history(
        history,
        pair,
    )

    if pair_hist.empty:
        return candidates

    used_weeks = set(
        pair_hist[
            "sampling_week"
        ].astype(int)
    )

    eligible = []

    for _, row in candidates.iterrows():

        week = sampling_week(
            row["call_date"],
            anchor,
        )

        if week not in used_weeks:
            eligible.append(row)

    if not eligible:
        return candidates.iloc[0:0].copy()

    return pd.DataFrame(
        eligible
    )


# ============================================================
# SAME-DAY ACROSS CATEGORY
# ============================================================

def apply_same_day_across_category(
    candidates,
    history,
    pair,
):
    """
    Enforce:

        Same auditor + same agent

    cannot have bind and policy change
    selected on the same calendar day.

    This rule applies across categories.
    """

    agent_hist = agent_history(
        history,
        pair,
    )

    if agent_hist.empty:
        return candidates

    used_days = set(
        pd.to_datetime(
            agent_hist[
                "call_date"
            ]
        ).dt.normalize()
    )

    return candidates[
        ~candidates[
            "call_date"
        ].dt.normalize()
        .isin(used_days)
    ].copy()


# ============================================================
# SAME-DAY WITHIN CATEGORY
# ============================================================

def apply_same_day_within_category(
    candidates,
    history,
    pair,
):
    """
    Enforce:

        Same auditor
        Same agent
        Same category

    cannot have multiple selections
    on the same calendar day.
    """

    pair_hist = pair_history(
        history,
        pair,
    )

    if pair_hist.empty:
        return candidates

    used_days = set(
        pd.to_datetime(
            pair_hist[
                "call_date"
            ]
        ).dt.normalize()
    )

    return candidates[
        ~candidates[
            "call_date"
        ].dt.normalize()
        .isin(used_days)
    ].copy()


# ============================================================
# RELAXATION LADDER
# ============================================================

def apply_relaxation_ladder(
    candidates,
    pair,
    history,
    config,
    anchor,
    allow_relaxation,
):
    """
    Constraint relaxation ladder.

    LEVEL 0
    -------
    Apply all configured constraints.

    LEVEL 1
    -------
    Relax weekly_rule_within_category.

    Same-day rules remain.

    LEVEL 2
    -------
    Relax same_day_rule_across_category.

    Same-category-day rule remains.

    LEVEL 3
    -------
    Relax same_day_within_category.

    LEVEL 4
    -------
    Relax call length.

    IMPORTANT
    ---------

    Relaxation is only allowed when
    allow_relaxation=True.

    Pacing decides whether relaxation
    is justified.

    Each level is explicit and separately
    identifiable.
    """

    # ========================================================
    # LEVEL 0 - STRICT
    # ========================================================

    level0 = candidates.copy()

    if config.weekly_rule_within_category:

        level0 = apply_weekly_rule(
            level0,
            history,
            pair,
            anchor,
        )

    if config.same_day_rule_across_category:

        level0 = (
            apply_same_day_across_category(
                level0,
                history,
                pair,
            )
        )

    if config.same_day_within_category:

        level0 = (
            apply_same_day_within_category(
                level0,
                history,
                pair,
            )
        )

    selected = (
        select_shortest_qualifying_call(
            level0,
            config.min_call_length,
            config.max_call_length,
        )
    )

    if selected is not None:

        return SelectionResult(
            call=selected,
            relaxation_level=(
                "LEVEL_0_STRICT"
            ),
            length_relaxed=False,
            reason=(
                "All configured constraints "
                "were satisfied."
            ),
        )

    # ========================================================
    # DO NOT RELAX YET
    # ========================================================

    if not allow_relaxation:

        return SelectionResult(
            call=None,
            relaxation_level=None,
            length_relaxed=False,
            reason=(
                "Strict selection unavailable, "
                "but quota is not yet at risk."
            ),
        )

    # ========================================================
    # LEVEL 1
    #
    # Drop weekly restriction.
    #
    # Keep both same-day restrictions.
    # ========================================================

    level1 = candidates.copy()

    if config.same_day_rule_across_category:

        level1 = (
            apply_same_day_across_category(
                level1,
                history,
                pair,
            )
        )

    if config.same_day_within_category:

        level1 = (
            apply_same_day_within_category(
                level1,
                history,
                pair,
            )
        )

    selected = (
        select_shortest_qualifying_call(
            level1,
            config.min_call_length,
            config.max_call_length,
        )
    )

    if selected is not None:

        return SelectionResult(
            call=selected,
            relaxation_level=(
                "LEVEL_1_WEEKLY_RELAXED"
            ),
            length_relaxed=False,
            reason=(
                "Weekly restriction relaxed "
                "because quota was at risk."
            ),
        )

    # ========================================================
    # LEVEL 2
    #
    # Drop same-day-across-category.
    #
    # Keep same-day-within-category.
    # ========================================================

    level2 = candidates.copy()

    if config.same_day_within_category:

        level2 = (
            apply_same_day_within_category(
                level2,
                history,
                pair,
            )
        )

    selected = (
        select_shortest_qualifying_call(
            level2,
            config.min_call_length,
            config.max_call_length,
        )
    )

    if selected is not None:

        return SelectionResult(
            call=selected,
            relaxation_level=(
                "LEVEL_2_SAME_DAY_ACROSS_CATEGORY_RELAXED"
            ),
            length_relaxed=False,
            reason=(
                "Same-day-across-category "
                "restriction relaxed "
                "because quota was at risk."
            ),
        )

    # ========================================================
    # LEVEL 3
    #
    # Drop same-day-within-category.
    # ========================================================

    level3 = candidates.copy()

    selected = (
        select_shortest_qualifying_call(
            level3,
            config.min_call_length,
            config.max_call_length,
        )
    )

    if selected is not None:

        return SelectionResult(
            call=selected,
            relaxation_level=(
                "LEVEL_3_SAME_DAY_WITHIN_CATEGORY_RELAXED"
            ),
            length_relaxed=False,
            reason=(
                "Same-day-within-category "
                "restriction relaxed "
                "because quota was at risk."
            ),
        )

    # ========================================================
    # LEVEL 4
    #
    # Relax length.
    #
    # All calendar constraints have already
    # been relaxed at this point.
    # ========================================================

    selected = (
        select_relaxed_length_call(
            level3,
            config.min_call_length,
            config.max_call_length,
        )
    )

    if selected is not None:

        return SelectionResult(
            call=selected,
            relaxation_level=(
                "LEVEL_4_LENGTH_RELAXED"
            ),
            length_relaxed=True,
            reason=(
                "Call-length threshold relaxed "
                "because quota was at risk."
            ),
        )

    # ========================================================
    # NOTHING FOUND
    # ========================================================

    return SelectionResult(
        call=None,
        relaxation_level=None,
        length_relaxed=False,
        reason=(
            "No candidate found after "
            "full constraint relaxation."
        ),
    )


# ============================================================
# UPDATE SELECTION HISTORY
# ============================================================

def add_selection(
    selections,
    pair,
    call,
    result,
    anchor,
):
    """
    Immediately add a selected call to the history.

    This is critical because if multiple calls are
    selected during today's run, the next selection
    must see the previous selection.

    Therefore:

        selected call
            ↓
        update history
            ↓
        next candidate check

    This prevents duplicates and correctly enforces
    same-day/week rules during the same run.
    """

    call_date = pd.Timestamp(
        call["call_date"]
    ).normalize()

    row = pd.DataFrame(
        [{
            "run_date": pd.Timestamp(
                call["run_date"]
            ).normalize(),

            "auditor_id": (
                pair.auditor_id
            ),

            "agent_id": (
                pair.agent_id
            ),

            "category": (
                pair.category
            ),

            "call_id": str(
                call["call_id"]
            ),

            "call_date": call_date,

            "call_length": float(
                call["call_length"]
            ),

            "sampling_week": (
                sampling_week(
                    call_date,
                    anchor,
                )
            ),

            "relaxation_level": (
                result.relaxation_level
            ),

            "length_relaxed": (
                result.length_relaxed
            ),

            "selection_reason": (
                result.reason
            ),
        }]
    )

    return pd.concat(
        [
            selections,
            row,
        ],
        ignore_index=True,
    )


