# ============================================================
# BASIC HELPERS
# ============================================================

def normalize_category(value):

    return (
        str(value)
        .strip()
        .lower()
        .replace("_", " ")
    )


def parse_bool(value):

    if isinstance(value, bool):
        return value

    if pd.isna(value):
        return False

    value = (
        str(value)
        .strip()
        .lower()
    )

    if value in {
        "true",
        "yes",
        "y",
        "1",
        "on",
    }:
        return True

    if value in {
        "false",
        "no",
        "n",
        "0",
        "off",
    }:
        return False

    raise ValueError(
        f"Invalid TRUE/FALSE value: {value}"
    )


def parse_optional_date(value):

    if pd.isna(value):
        return None

    value = str(value).strip()

    if not value:
        return None

    return pd.Timestamp(
        pd.to_datetime(value)
    ).normalize()


def month_from_date(date):

    return pd.Timestamp(
        date
    ).strftime("%Y-%m")


# ============================================================
# VACATION
# ============================================================

def build_vacation_dates(
    vacation_date,
    vacation_start_date,
    vacation_end_date,
):
    """
    Supports:

        Single date:
            vacation_date

        Range:
            vacation_start_date
            vacation_end_date

        Both:
            vacation_date
            vacation_start_date
            vacation_end_date
    """

    dates = set()

    single = parse_optional_date(
        vacation_date
    )

    if single is not None:
        dates.add(single)

    start = parse_optional_date(
        vacation_start_date
    )

    end = parse_optional_date(
        vacation_end_date
    )

    if start is not None and end is None:
        raise ValueError(
            "vacation_start_date requires "
            "vacation_end_date"
        )

    if end is not None and start is None:
        raise ValueError(
            "vacation_end_date requires "
            "vacation_start_date"
        )

    if start is not None and end is not None:

        if end < start:
            raise ValueError(
                "Vacation end date cannot "
                "be before vacation start date."
            )

        for date in pd.date_range(
            start,
            end,
            freq="D",
        ):
            dates.add(
                pd.Timestamp(date).normalize()
            )

    return dates


